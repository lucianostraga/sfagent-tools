[1.034, "o", "\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1m12 MCP tools. One plugin. Real agent. Real Salesforce.\u001b[0m\r\n"]
