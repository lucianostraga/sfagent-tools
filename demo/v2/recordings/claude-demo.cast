[1.023, "o", "\r\n\u001b[38;2;215;119;87m⏺\u001b[0m Listing agents in the sfagent-dev org to get the API name.\r\n\r\n"]
[1.302, "o", "  \u001b[38;2;136;136;136m⎿ Called \u001b[0m\u001b[1msfagent-tools\u001b[0m\u001b[38;2;136;136;136m - list_agents\u001b[0m\r\n"]
[0.351, "o", "\r\n\u001b[38;2;215;119;87m⏺\u001b[0m Starting the session.\r\n\r\n"]
[1.301, "o", "  \u001b[38;2;136;136;136m⎿ Called \u001b[0m\u001b[1msfagent-tools\u001b[0m\u001b[38;2;136;136;136m - start_session\u001b[0m\r\n"]
[0.352, "o", "  \u001b[38;2;136;136;136m⎿ Called \u001b[0m\u001b[1msfagent-tools\u001b[0m\u001b[38;2;136;136;136m - send_message\u001b[0m\r\n"]
[0.351, "o", "  \u001b[38;2;136;136;136m⎿ Called \u001b[0m\u001b[1msfagent-tools\u001b[0m\u001b[38;2;136;136;136m - send_message\u001b[0m\r\n"]
[0.351, "o", "  \u001b[38;2;136;136;136m⎿ Called \u001b[0m\u001b[1msfagent-tools\u001b[0m\u001b[38;2;136;136;136m - send_message\u001b[0m\r\n"]
[0.351, "o", "  \u001b[38;2;136;136;136m⎿ Called \u001b[0m\u001b[1msfagent-tools\u001b[0m\u001b[38;2;136;136;136m - generate_test_spec\u001b[0m\r\n"]
[0.352, "o", "  \u001b[38;2;136;136;136m⎿ Called \u001b[0m\u001b[1msfagent-tools\u001b[0m\u001b[38;2;136;136;136m - end_session\u001b[0m\r\n"]
[0.352, "o", "\r\n\u001b[38;2;215;119;87m⏺\u001b[0m All three turns passed: the order-help opener correctly triggered identity verification, the email submission advanced to the OTP step, and the \"speak to a manager\" utterance escalated to a human handoff — no guardrail or routing failures. The regression spec was saved to `sfagent-reports/smoke-test.yaml` (3 cases, runnable via `sf agent test run-eval`).\r\n\r\n"]
[2.537, "o", "\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.000, "o", "\u001b[1mOne sentence. Real conversation. Real findings. Ready for CI.\u001b[0m\r\n"]
[0.001, "o", "\u001b[38;2;136;136;136mInstall:\u001b[0m  claude plugin install sfagent-tools@sfagent-tools-marketplace\r\n"]
