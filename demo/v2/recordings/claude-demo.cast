[1.211, "o", "\u001b[38;2;215;119;87m⏺\u001b[0m Listing agents in the sfagent-dev org to get the API name.\r\n\r\n"]
[1.803, "o", "  \u001b[38;2;136;136;136m⎿ Called \u001b[1msfagent-tools\u001b[0m\u001b[38;2;136;136;136m (ctrl+o to expand)\u001b[0m\r\n\r\n"]
[1.101, "o", "\u001b[38;2;215;119;87m⏺\u001b[0m Starting the session.\r\n\r\n"]
[1.801, "o", "  \u001b[38;2;136;136;136m⎿ Called \u001b[1msfagent-tools\u001b[0m\u001b[38;2;136;136;136m 6 times (ctrl+o to expand)\u001b[0m\r\n\r\n"]
[1.103, "o", "\u001b[38;2;215;119;87m⏺\u001b[0m All three turns passed: the order-help opener correctly triggered identity verification, the email submission advanced to the OTP step, and the \"speak to a manager\" utterance escalated to a human handoff — no guardrail or routing failures. The regression spec was saved to `sfagent-reports/smoke-test.yaml` (3 cases, runnable via `sf agent test run-eval`).\r\n\r\n"]
[3.048, "o", "\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.000, "o", "\u001b[1mOne sentence. Real conversation. Real findings. Ready for CI.\u001b[0m\r\n"]
[0.002, "o", "\u001b[38;2;136;136;136mInstall:\u001b[0m  claude plugin install sfagent-tools@sfagent-tools-marketplace\r\n"]
