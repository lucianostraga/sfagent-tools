[0.013, "o", "\u001b[2m  ⤷ {\r\n    \"suiteName\": \"demo-suite\",\r\n    \"cases\": 2,\r\n    \"outputPath\": \"sfagent-reports/demo-suite.yaml\",\r\n    \"nextStep\": \"sf agent test run-eval --spec sfagent-reports/demo-suite.yaml --target-org <alias>\",\r\n    \"preview\": \"# Generated by sfagent-tools from an exploratory session\\n# Run with: sf agent test run-eval --spec demo-suite.yaml --target-org <alias>\\nsuite: demo-suite\\nagent:\\n  apiName: Agentforce_Ser\u001b[2m\r\n    ...(truncated)\u001b[0m\u001b[0m\r\n"]
