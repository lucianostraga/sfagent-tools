{
  "name": "sfagent-tools-mcp-server",
  "version": "0.2.1",
  "description": "MCP server for testing Salesforce Agentforce agents. Powers the SFAgent Tools plugin for Claude Code and Codex.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sfagent-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "salesforce",
    "agentforce",
    "agent-testing",
    "claude-code",
    "codex"
  ],
  "author": {
    "name": "Luciano Straga",
    "url": "https://github.com/lucianostraga"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucianostraga/sfagent-tools.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/lucianostraga/sfagent-tools#readme",
  "bugs": {
    "url": "https://github.com/lucianostraga/sfagent-tools/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@salesforce/core": "^8.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
